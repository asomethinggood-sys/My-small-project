<Window x:Class="Continuum.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Continuum" Width="960" Height="700" MinWidth="800" MinHeight="650" Background="#0A141C" WindowStartupLocation="CenterScreen">
 <Grid Margin="34">
  <Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="◉" Foreground="#65E6C0" FontSize="30" Margin="0,0,13,0"/><StackPanel><TextBlock Text="continuum" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="A quieter connection." Foreground="#91A8B3" FontSize="12"/></StackPanel></StackPanel><TextBlock Text="WINDOWS  •  0.1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#91A8B3" FontSize="11"/></Grid>
  <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="20" Padding="26">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="YOUR CONNECTION" Foreground="#91A8B3" FontSize="11"/><TextBlock x:Name="StatusTitle" Text="Ready when you are" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="StatusDetail" Text="Connect using your normal Continuum subscription." TextWrapping="Wrap" Foreground="#A5BAC3" Margin="0,10,0,0" LineHeight="21"/></StackPanel>
     <Grid Grid.Row="1" Margin="0,20"><Ellipse Width="180" Height="180" Stroke="#243C45" StrokeThickness="1"/><Ellipse Width="144" Height="144" Stroke="#3A6667" StrokeThickness="2"/><Border x:Name="Orb" Width="112" Height="112" CornerRadius="56" Background="#203B42"><TextBlock x:Name="OrbText" Text="○" FontSize="66" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#65E6C0"/></Border></Grid>
     <StackPanel Grid.Row="2"><TextBlock x:Name="Latency" Text="HTTPS CHECK  —" Foreground="#91A8B3" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,16"/><Button x:Name="ConnectButton" Content="Connect" Background="#65E6C0" Foreground="#09251E" FontWeight="SemiBold" Click="ToggleConnection" AutomationProperties.AutomationId="Connect"/><Button x:Name="CheckButton" Content="Check now" Margin="0,10,0,0" Click="CheckNow" IsEnabled="False"/></StackPanel>
    </Grid>
   </Border>
   <StackPanel Grid.Column="2">
    <Border Background="{StaticResource Panel}" CornerRadius="18" Padding="22"><StackPanel>
     <TextBlock Text="Connection source" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Use the original automatic subscription, or paste one supported connection link." Foreground="#A5BAC3" TextWrapping="Wrap" LineHeight="20" Margin="0,9,0,16"/>
     <ComboBox x:Name="SourceMode" SelectedIndex="0" Padding="10" Margin="0,0,0,10"><ComboBoxItem Content="Automatic subscription (HTTPS)"/><ComboBoxItem Content="Imported connection link"/></ComboBox>
     <TextBox x:Name="SourceText" Height="106" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="False" AutomationProperties.AutomationId="Source"/>
     <Button Content="Use normal Continuum subscription" Margin="0,12,0,0" Padding="10" FontSize="12" Click="UseDefault"/>
     <Grid Margin="0,22,0,0"><TextBlock Text="Tunnel MTU" VerticalAlignment="Center" Foreground="#A5BAC3"/><ComboBox x:Name="Mtu" Width="110" HorizontalAlignment="Right" SelectedIndex="1" Padding="7"><ComboBoxItem Content="1280"/><ComboBoxItem Content="1400"/><ComboBoxItem Content="1500"/></ComboBox></Grid>
    </StackPanel></Border>
    <Border BorderBrush="#29404B" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,18,0,0"><StackPanel><TextBlock Text="DEVICE-WIDE TUNNEL" Foreground="#65E6C0" FontSize="11"/><TextBlock Text="TCP, UDP and proxied DNS via Xray + Wintun. No country-pool routing. Subscription changes are checked every five minutes." TextWrapping="Wrap" Foreground="#A5BAC3" LineHeight="20" Margin="0,9,0,0"/><TextBlock Text="Not an always-on kill switch. Internet may use your normal connection while disconnected or recovering." TextWrapping="Wrap" Foreground="#D3BB8C" FontSize="11" LineHeight="18" Margin="0,10,0,0"/></StackPanel></Border>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2"><TextBlock Text="Local settings encrypted for your Windows account. No analytics." Foreground="#7F98A4" FontSize="11" VerticalAlignment="Bottom"/><Button Content="Minimize to tray" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="8,4" FontSize="11" Click="MinimizeToTray"/></Grid>
 </Grid>
</Window>
